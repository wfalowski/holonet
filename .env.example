# The single auth credential. Min 16 chars enforced.
APP_KEY=

# OpenRouter bearer token.
OPENROUTER_API_KEY=

# HMAC key for signed cookie. Defaults to sha256(APP_KEY + ":holonet-session") hex.
SESSION_SECRET=

# SQLite file path (directory auto-created).
DATABASE_PATH=./data/holonet.db

# HTTP port.
PORT=3000

# Set true when running behind TLS.
COOKIE_SECURE=false

# Trust X-Forwarded-For for client IP (set true only behind a reverse proxy)
TRUST_PROXY=false

# Timezone cron schedules are interpreted in (croner default = system TZ).
TZ=
